{
  "name": "mini-ide",
  "private": true,
  "version": "0.0.0",
  "description": "Mini-IDE monorepo",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.2",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "test": "pnpm -r run test",
    "test:watch": "pnpm -r run test:watch",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "ci:all": "pnpm build && pnpm typecheck && pnpm lint && pnpm test",
    "prepare": "husky",
    "dev:all": "pnpm -F @mini-ide/server run dev",
    "docs": "typedoc",
    "docs:serve": "python3 -m http.server 8080 -d docs/api",
    "dev:server": "PORT=3200 node packages/server/dist/index.js",
    "docs:generate": "bash scripts/generate_docs_stub.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^4.0.7",
    "eslint": "^9.39.1",
    "husky": "9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typedoc": "^0.28.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^4.0.7"
  },
  "type": "module"
}
