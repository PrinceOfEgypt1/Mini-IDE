/**
 * Test utilities for server package (Mini-IDE)
 * - build() síncrono (FastifyInstance)
 * - inject() aceita string (URL) OU objeto (Injectable)
 * - Normalização de headers/body com type guards (zero any)
 */

import type { FastifyInstance } from 'fastify';
import { createServer } from '../src/index.js';

/** Configuração de request injetado no Fastify */
export interface Injectable {
  method?: 'GET' | 'POST' | 'PUT' | 'DELETE' | 'PATCH' | 'HEAD' | 'OPTIONS';
  url?: string;
  path?: string;
  payload?: unknown;
  headers?: Record<string, string>;
}

/** Resposta de teste com corpo em texto */
export interface TestResponse {
  statusCode: number;
  headers: Record<string, string | string[] | undefined>;
  body: string;
}

/** Constrói a instância do servidor para testes (síncrono). */
export function build(): FastifyInstance {
  const server = createServer();
  return server;
}

/** Encerra o servidor com shutdown gracioso */
export async function shutdown(server: FastifyInstance): Promise<void> {
  await server.close();
}

/** Normaliza headers de `unknown` para o contrato estrito permitido */
function normalizeHeaders(
  src: unknown
): Record<string, string | string[] | undefined> {
  const out: Record<string, string | string[] | undefined> = {};
  if (typeof src !== 'object' || src === null) return out;

  const dict = src as Record<string, unknown>;
  for (const key in dict) {
    const v = dict[key];
    if (typeof v === 'string' || typeof v === 'undefined') out[key] = v;
    else if (Array.isArray(v) && v.every((i) => typeof i === 'string')) out[key] = v;
  }
  return out;
}

/** Converte body desconhecido para string sem base-to-string implícito */
function toBodyString(src: unknown): string {
  if (typeof src === 'string') return src;
  if (src == null) return '';
  if (typeof src === 'number' || typeof src === 'boolean' || typeof src === 'bigint') {
    return String(src);
  }
  if (src instanceof Uint8Array) {
    try {
      const decoder = new TextDecoder('utf-8', { fatal: false, ignoreBOM: true });
      return decoder.decode(src);
    } catch {
      return '';
    }
  }
  if (typeof src === 'object') {
    try {
      return JSON.stringify(src);
    } catch {
      return '';
    }
  }
  return '';
}

/** Tipo mínimo para quebrar fluxo any de light-my-request */
type LmrResponse = {
  statusCode?: unknown;
  headers?: unknown;
  body?: unknown;
};

/* ---------- inject() overloads ---------- */
export async function inject(server: FastifyInstance, request: Injectable): Promise<TestResponse>;
export async function inject(server: FastifyInstance, url: string): Promise<TestResponse>;
export async function inject(
  server: FastifyInstance,
  requestOrUrl: Injectable | string
): Promise<TestResponse> {
  // method default GET
  const method: Injectable['method'] = (() => {
    const m = typeof requestOrUrl === 'string' ? undefined : requestOrUrl.method;
    return (m === 'GET' || m === 'POST' || m === 'PUT' || m === 'DELETE' ||
            m === 'PATCH' || m === 'HEAD' || m === 'OPTIONS') ? m : 'GET';
  })();

  // aceitar url string direta OU objeto com url/path
  const urlOrPath: string = (() => {
    if (typeof requestOrUrl === 'string') return requestOrUrl || '/';
    if (typeof requestOrUrl.url === 'string' && requestOrUrl.url.length > 0) return requestOrUrl.url;
    if (typeof requestOrUrl.path === 'string' && requestOrUrl.path.length > 0) return requestOrUrl.path;
    return '/';
  })();

  const payload = typeof requestOrUrl === 'string' ? undefined : requestOrUrl.payload;
  const headersIn = typeof requestOrUrl === 'string' ? undefined : requestOrUrl.headers;

  /** IMPORTANTE: quebrar fluxo any do inject() tipando como unknown */
  const responseUnknown: unknown = await server.inject({
    method,
    url: urlOrPath,
    payload,
    headers: headersIn,
  });

  // Acesso seguro via tipo mínimo (unknown -> LmrResponse)
  const resp = responseUnknown as LmrResponse;

  const safeHeaders = normalizeHeaders(resp.headers);
  const body = toBodyString(resp.body);

  const sc = resp.statusCode;
  const statusCode = typeof sc === 'number' ? sc : 0;

  return { statusCode, headers: safeHeaders, body };
}

/** Helper para obter o status HTTP */
export function status(response: TestResponse): number {
  return response.statusCode;
}

/** Faz o parse do JSON com checagem de objeto não-nulo. */
export function jsonUnknown<T extends Record<string, unknown>>(response: TestResponse): T {
  const parsed: unknown = JSON.parse(response.body);
  if (typeof parsed !== 'object' || parsed === null || Array.isArray(parsed)) {
    throw new TypeError('Expected JSON response to be a non-null object');
  }
  return parsed as T;
}
