import type { FastifyInstance } from 'fastify'

// Ajuste esta função para usar sua fábrica/registrar rotas reais.
// Ex.: import { registerRoutes } from './http/server'
//     export async function createServer(app: FastifyInstance) { registerRoutes(app); }
export async function createServer(app: FastifyInstance): Promise<void> {
  // healthz mínima para passar os testes, se sua rota real já existir, remova isto.
  app.get('/healthz', async () => ({ ok: true, ts: new Date().toISOString() }))

  // Exemplo de /analyze compatível com seus testes (ajuste para o handler real)
  app.post('/analyze', {
    schema: {
      body: {
        type: 'object',
        required: ['text'],
        properties: {
          text: { type: 'string', minLength: 1 },
          maxLen: { type: 'integer', minimum: 1, maximum: 1000 }
        },
        additionalProperties: false
      }
    }
  }, async (req, reply) => {
    // @ts-expect-error - tipagem breve (ajuste p/ seu DTO)
    const { text, maxLen = 100 } = req.body || {}
    if (typeof text !== 'string' || text.trim().length === 0) {
      return reply.code(400).send({ error: 'invalid_text' })
    }
    if (!Number.isInteger(maxLen) || maxLen < 1 || maxLen > 1000) {
      return reply.code(400).send({ error: 'invalid_maxLen' })
    }
    const tokens = text.trim().split(/\s+/).slice(0, maxLen)
    return { summary: tokens.join(' '), tokens }
  })
}
