{
  "name": "@mini-ide/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Ferramentas de linha de comando.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
