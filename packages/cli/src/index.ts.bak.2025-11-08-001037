// packages/cli/src/index.ts
/**
 * Mini-IDE CLI - Comando `analyze`
 * Contrato /analyze (HU-Server-Analyze-200):
 *   Body: { text: string, maxLen?: number }
 *   200:  { summary: string, tokensUsed: number, runId: string, ts: string }
 *
 * CLI:
 *   node dist/index.js analyze "<texto>" [--maxLen N] [--url http://127.0.0.1:3200]
 *
 * Saída do CLI:
 *   - Salva JSON:  <cwd>/bundles/v1.0.12/analysis-YYYY-MM-DD.json
 *   - Imprime CAMINHO ABSOLUTO do arquivo salvo (para o checklist).
 */

import * as fs from "node:fs";
import * as path from "node:path";
import process from "node:process";

export type AnalyzeResponse = {
  summary: string;
  tokensUsed: number;
  runId: string;
  ts: string;
};

export function usageAndExit(msg?: string): never {
  if (msg) console.error(msg);
  console.error(`
uso:
  mini-ide analyze "<texto>" [--maxLen N] [--url http://127.0.0.1:3200]

exemplos:
  mini-ide analyze "  Linha 1  \\n\\n   Linha 2\\tok  "
  mini-ide analyze "texto" --maxLen 80
  mini-ide analyze "texto" --url http://127.0.0.1:3200
`);
  process.exit(1);
}

/**
 * Faz o parse dos argumentos do CLI.
 * Aceita: analyze "<texto>" [--maxLen N] [--url ...]
 */
export function parseArgs(argv: string[]) {
  // ["node","dist/index.js","analyze","<texto>","--maxLen","42","--url","http://..."]
  const args = argv.slice(2);
  const cmd = args[0];
  if (cmd !== "analyze") {
    usageAndExit('erro: comando inválido. Use: mini-ide analyze "<texto>" [--maxLen N] [--url ...]');
  }

  const text = args[1];
  if (typeof text !== "string") usageAndExit("erro: texto obrigatório entre aspas.");

  let maxLen: number | undefined = undefined;
  let url = "http://127.0.0.1:3200";

  for (let i = 2; i < args.length; i++) {
    const a = args[i];
    if (a === "--maxLen") {
      const v = args[++i];
      if (!v || isNaN(Number(v))) usageAndExit("erro: --maxLen requer um número.");
      maxLen = Number(v);
      continue;
    }
    if (a === "--url") {
      const v = args[++i];
      if (!v) usageAndExit("erro: --url requer um valor.");
      url = v;
      continue;
    }
    usageAndExit(`erro: parâmetro desconhecido: ${a}`);
  }

  return { text, maxLen, url };
}

/**
 * Função programática usada pelos testes:
 * Realiza o POST /analyze e (opcionalmente) salva a resposta em arquivo.
 */
export async function parseAnalyze(
  text: string,
  opts?: { maxLen?: number; url?: string; outDir?: string; saveFile?: boolean }
): Promise<{ response: AnalyzeResponse; filePath?: string }> {
  const url = (opts?.url ?? "http://127.0.0.1:3200").replace(/\/+$/, "") + "/analyze";

  const body: Record<string, unknown> = { text };
  if (typeof opts?.maxLen === "number") body["maxLen"] = opts.maxLen;

  const res = await fetch(url, {
    method: "POST",
    headers: { "content-type": "application/json" },
    body: JSON.stringify(body),
  });

  if (!res.ok) {
    const txt = await res.text().catch(() => "");
    throw new Error(`erro HTTP ${res.status}: ${txt || res.statusText}`);
  }

  const response = (await res.json()) as AnalyzeResponse;

  if (
    typeof response.summary !== "string" ||
    typeof response.tokensUsed !== "number" ||
    typeof response.runId !== "string" ||
    typeof response.ts !== "string"
  ) {
    throw new Error(`payload inesperado do /analyze: ${JSON.stringify(response)}`);
  }

  let filePath: string | undefined;

  if (opts?.saveFile) {
    const outDir = opts.outDir ?? path.join(process.cwd(), "bundles", "v1.0.12");
    fs.mkdirSync(outDir, { recursive: true });

    const d = new Date();
    const yyyy = String(d.getFullYear()).padStart(4, "0");
    const mm = String(d.getMonth() + 1).padStart(2, "0");
    const dd = String(d.getDate()).padStart(2, "0");
    filePath = path.join(outDir, `analysis-${yyyy}-${mm}-${dd}.json`);
    fs.writeFileSync(filePath, JSON.stringify(response, null, 2), "utf8");
  }

  return { response, filePath };
}

/**
 * Entry point do CLI. Usa parseArgs + parseAnalyze e imprime caminho do arquivo salvo.
 */
async function main() {
  const { text, maxLen, url } = parseArgs(process.argv);

  const { filePath } = await parseAnalyze(text, {
    maxLen,
    url,
    saveFile: true,
    outDir: path.join(process.cwd(), "bundles", "v1.0.12"),
  });

  // IMPORTANTE: imprimir caminho ABSOLUTO (o checklist faz grep disso)
  if (filePath) {
    console.log(path.resolve(filePath));
  }
}

if (import.meta.url === `file://${process.argv[1]}`) {
  main().catch((err) => {
    console.error("erro inesperado:", err instanceof Error ? err.message : String(err));
    process.exit(99);
  });
}
